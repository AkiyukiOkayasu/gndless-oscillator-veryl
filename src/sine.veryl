/// サイン波生成コアモジュール (LUTのみ)
/// 位相入力から波形を生成する純粋な変換モジュール
/// 第一象限(0~90度)の波形データ10bit分をROMに持っているので、実質的な分解能は12bit相当
/// レイテンシー: 3クロック (全wave core統一。BRAM読み出し1 + 遅延整合2)
pub module SineWaveCore (
    clk  : input   clock                                                                        , /// クロック
    phase: input   gndless_nco::Phase::phase_t                                                  , /// 位相入力 (0 ~ 2^32-1)
    audio: modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    // ----------------------------------------------------
    // 象限判定とROMアドレス計算
    // ----------------------------------------------------
    // 上位2ビットで象限(Quadrant)を知る
    // 00: 0~90度, 01: 90~180度, 10: 180~270度, 11: 270~360度
    var quadrant: logic<2>;
    assign quadrant = phase[msb:msb - 1];

    // ROMのアドレス幅
    // 奇数象限は波形が「戻る」ため、有効位相を反転してから [29:20] の10bitを使用
    var eff_phase: logic<30>;
    always_comb {
        if quadrant[0] {
            eff_phase = ~phase[29:0];
        } else {
            eff_phase = phase[29:0];
        }
    }

    var rom_addr: logic<10>;
    assign rom_addr = eff_phase[29:20];

    // ----------------------------------------------------
    // ROM読み出し (0~90度の振幅データ、Q1.23)
    // ----------------------------------------------------
    var rom_data: gndless_fixedpoint::Q1_23::Raw; // 符号なしの絶対値 (0 ~ 2^23-1)
    inst u_rom: SineRomQuarter (
        clk           ,
        addr: rom_addr,
        data: rom_data,
    );

    // ----------------------------------------------------
    // Q1.23 → Q4.23 符号拡張と遅延整合 (全wave coreで3クロックに統一)
    // ----------------------------------------------------
    var val        : gndless_fixedpoint::Q4_23::Raw   ;
    var quadrant_d : logic                         <2>;
    var val_d2     : gndless_fixedpoint::Q4_23::Raw   ;
    var quadrant_d2: logic                         <2>;

    always_ff (clk) {
        val        = $std::sign_extend::<gndless_fixedpoint::Q1_23::Raw, gndless_fixedpoint::Q4_23::Raw>(rom_data);
        quadrant_d = quadrant;
    }

    always_ff (clk) {
        val_d2      = val;
        quadrant_d2 = quadrant_d;
    }

    // 第3・第4象限はマイナス側
    always_comb {
        if quadrant_d2[1] {
            audio.raw = -val_d2;
        } else {
            audio.raw = val_d2;
        }
    }
}

/// サイン波生成コアモジュール (LUT + 線形補間)
/// 位相入力から波形を生成する純粋な変換モジュール
/// 実質12bit相当のテーブル引きに線形補間を追加することで、高精細なサイン波を生成
/// 補間は27bit × 18bit (Q1.17係数) の乗算を使う
/// レイテンシー: 3クロック (ROM | diff+係数 | 乗算+加算・符号の3段pipeline)
pub module SineWaveLerpCore (
    clk  : input   clock                                                                        , /// クロック
    phase: input   gndless_nco::Phase::phase_t                                                  , /// 位相入力 (0 ~ 2^32-1)
    audio: modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    // ----------------------------------------------------
    // 象限判定と「三角波状」位相への変換 (stage 0: 組み合わせ)
    // ----------------------------------------------------
    // 上位2ビットが象限、残り30ビットが有効位相
    var quadrant: logic<2>;
    assign quadrant = phase[31:30];

    var eff_phase: logic<30>; //三角波状有効位相
    always_comb {
        // 第2・第4象限はビット反転して折り返す
        if quadrant[0] {
            eff_phase = ~phase[29:0];
        } else {
            eff_phase = phase[29:0];
        }
    }

    // ----------------------------------------------------
    // ROMアドレスと補間係数の計算
    // ----------------------------------------------------
    // ROMアドレス: 上位10bit (29 down to 20)
    var idx: logic<10>;
    assign idx = eff_phase[29:20];

    // 小数部を補間係数とする: 下位20bit (19 down to 0)
    var frac: logic<20>;
    assign frac = eff_phase[19:0];

    // 隣り合うROMアドレスの計算
    // 1023を超えないようにガード (最後のスライスはピーク側をQ1_23::MAXで補間する)
    var addr_a: logic<10>;
    var addr_b: logic<10>;
    always_comb {
        addr_a = idx;
        if idx == 10'd1023 {
            addr_b = 10'd1023;
        } else {
            addr_b = idx + 1;
        }
    }

    // ROM読み出し (Q1.23)
    var val_a: gndless_fixedpoint::Q1_23::Raw; //符号なしの絶対値 (0 ~ 2^23-1)
    var val_b: gndless_fixedpoint::Q1_23::Raw; //符号なしの絶対値 (0 ~ 2^23-1)
    inst rom: SineRomQuarterDual (
        clk          ,
        addr_a       ,
        addr_b       ,
        data_a: val_a,
        data_b: val_b,
    );

    // ----------------------------------------------------
    // stage 1: 差分・係数 (ROM読み出し結果から1クロック後)
    // ----------------------------------------------------
    // 最後のスライス (idx==1023) は 90° ちょうどの値 Q1_23::MAX との補間にする
    // (テーブル末尾は sin(1023h) = cos(h) なので、このまま補間するとピークが10LSB平らになる)
    var val_b_eff: gndless_fixedpoint::Q1_23::Raw;
    always_comb {
        if idx == 10'd1023 {
            val_b_eff = gndless_fixedpoint::Q1_23::MAX;
        } else {
            val_b_eff = val_b;
        }
    }

    // Formula: Out = A + (B - A) * frac
    // diff: Q4.23 (27bit) で計算 (隣接テーブル間の差は27bit signedに収まる)
    // coeff: Q1.17 (18bit signed、小数17bit) = frac上位17bit
    var val_a_27  : gndless_fixedpoint::Q4_23::Raw    ;
    var diff      : signed logic                  <27>;
    var coeff     : signed logic                  <18>;
    var quadrant_d: logic                         <2> ;

    always_ff (clk) {
        val_a_27   = $std::sign_extend::<gndless_fixedpoint::Q1_23::Raw, gndless_fixedpoint::Q4_23::Raw>(val_a);
        diff       = $std::sign_extend::<gndless_fixedpoint::Q1_23::Raw, gndless_fixedpoint::Q4_23::Raw>(val_b_eff)
            - $std::sign_extend::<gndless_fixedpoint::Q1_23::Raw, gndless_fixedpoint::Q4_23::Raw>(val_a);
        coeff      = $signed({1'b0, frac[19:3]});
        quadrant_d = quadrant;
    }

    // ----------------------------------------------------
    // stage 2: 乗算 (27bit signed × 18bit signed = 45bit)
    // ----------------------------------------------------
    var mult       : signed logic<45>;
    var quadrant_d2: logic       <2> ;

    always_ff (clk) {
        // 乗算の結果幅を明示するため、両オペランドを積幅 (45bit) へ拡張してから乗算する
        mult        = (diff as 45) * (coeff as 45);
        quadrant_d2 = quadrant_d;
    }

    // ----------------------------------------------------
    // stage 3: 加算・符号 (組み合わせ)
    // ----------------------------------------------------
    // 積の小数ビット数は 23 + 17 = 40 なので、>>>17 で Q4.23 に戻してから加算
    // interp は val_a と val_b の間に収まり27bitに飽和しないため sat 不要
    var interp: signed logic<27>;
    always_comb {
        interp = (val_a_27 as 28 + (mult >>> 17)) as 27;

        // 第3・第4象限はマイナス側
        if quadrant_d2[1] {
            audio.raw = -interp;
        } else {
            audio.raw = interp;
        }
    }
}

/// サイン波オシレーター (LUTのみ)
/// テーブル引きのサイン波
/// 第一象限(0~90度)の波形データ10bit分をROMに持っているので、実質的な分解能は12bit相当
/// レイテンシー: 3クロック (全wave core統一)
pub module SineOscillator (
    clk       : input   clock                                                                        , /// クロック
    phase_rst : input   bbool                                                                        , /// 位相ゼロリセット (同期)
    phase_step: input   gndless_nco::Phase::step_t                                                   , /// 1クロックあたりの位相ステップ量: step = (ターゲット周波数 * 2^48) / システムクロック周波数
    audio     : modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    // 位相生成 (Phase Accumulator)
    var phase: gndless_nco::Phase::phase_t;
    inst phasor: gndless_nco::Phasor ( clk, phase_rst, phase_step, phase );

    // サイン波生成
    inst core: SineWaveCore ( clk, phase, audio );
}

/// サイン波オシレーター (LUT + 線形補間)
/// 実質12bit相当のテーブル引きに線形補間を追加することで、高精細なサイン波を生成
/// レイテンシー: 3クロック (全wave core統一)
pub module SineOscillatorLerp (
    clk       : input   clock                                                                        , /// クロック
    phase_rst : input   bbool                                                                        , /// 位相ゼロリセット (同期)
    phase_step: input   gndless_nco::Phase::step_t                                                   , /// 1クロックあたりの位相ステップ量: step = (ターゲット周波数 * 2^48) / システムクロック周波数
    audio     : modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    // 位相生成
    var phase: gndless_nco::Phase::phase_t;
    inst phasor: gndless_nco::Phasor ( clk, phase_rst, phase_step, phase );

    // サイン波生成 (線形補間付き)
    inst core: SineWaveLerpCore ( clk, phase, audio );
}

/// サイン波コアの位相変換とレイテンシーを検証
/// 期待値はSineRomDataのテーブル値 (table[512] = 0x5A8278 = 5931640、table[1023] = 0x7FFFF5 = 8388597)
#[test(test_sine_wave_core)]
module test_sine_wave_core {
    inst clk: $tb::clock_gen;

    var phase: gndless_nco::Phase::phase_t;
    inst audio: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;

    inst dut: SineWaveCore ( clk, phase, audio );

    initial {
        phase = 32'h0000_0000;
        clk.next(3);
        $assert(audio.raw == gndless_fixedpoint::Q4_23::ZERO, "sine 0deg mismatch");

        phase = 32'h2000_0000;
        clk.next(3);
        $assert(audio.raw == 27'sd5931640, "sine 45deg mismatch");

        phase = 32'h4000_0000;
        clk.next(3);
        $assert(audio.raw == 27'sd8388597, "sine 90deg mismatch");

        phase = 32'h8000_0000;
        clk.next(3);
        $assert(audio.raw == gndless_fixedpoint::Q4_23::ZERO, "sine 180deg mismatch");

        phase = 32'hC000_0000;
        clk.next(3);
        $assert(audio.raw == -27'sd8388597, "sine 270deg mismatch");

        $finish();
    }
}

/// サイン波コア (線形補間) の位相変換とレイテンシーを検証
/// 期待値はテーブル値と補間式から導出:
///   45度 (frac=0)      : table[512] = 5931640
///   frac < 2^3         : coeff=0 なので table[512] のまま
///   中点 (frac=2^19)    : table[512] + (table[513]-table[512])/2 = 5931640 + 4546 = 5936186
///   90度 (idx=1023)    : table[1023] + (Q1_23::MAX - table[1023])*coeff>>>17 = 8388597 + 9 = 8388606
#[test(test_sine_wave_lerp_core)]
module test_sine_wave_lerp_core {
    inst clk: $tb::clock_gen;

    var phase: gndless_nco::Phase::phase_t;
    inst audio: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;

    inst dut: SineWaveLerpCore ( clk, phase, audio );

    initial {
        phase = 32'h0000_0000;
        clk.next(3);
        $assert(audio.raw == gndless_fixedpoint::Q4_23::ZERO, "lerp 0deg mismatch");

        phase = 32'h2000_0000;
        clk.next(3);
        $assert(audio.raw == 27'sd5931640, "lerp 45deg (frac=0) mismatch");

        phase = 32'h2000_0001;
        clk.next(3);
        $assert(audio.raw == 27'sd5931640, "lerp frac<2^3 (coeff=0) mismatch");

        phase = 32'h2008_0000;
        clk.next(3);
        $assert(audio.raw == 27'sd5936186, "lerp midpoint mismatch");

        phase = 32'h4000_0000;
        clk.next(3);
        $assert(audio.raw == 27'sd8388606, "lerp 90deg peak mismatch");

        phase = 32'hA000_0000;
        clk.next(3);
        $assert(audio.raw == -27'sd5931640, "lerp quadrant sign mismatch");

        $finish();
    }
}

/// サイン波コア (線形補間) の連続位相更新時 (オシレーター実動作) の出力連続性を検証
/// 位相ステップ2^14あたりの最大変化量 ≈ 2π * 2^14 / 2^32 * 2^23 ≈ 201 LSB。
/// 3段pipelineのタイミング不整合 (stale値混入) があると10^6オーダーの不連続が出るため、
/// 上限1024 LSBで検出する。位相は32bitで自然にラップする (サインは周期関数)。
#[test(test_sine_wave_lerp_core_sweep)]
module test_sine_wave_lerp_core_sweep {
    inst clk: $tb::clock_gen;

    const STEP: gndless_nco::Phase::phase_t = 32'd16384;

    var phase: gndless_nco::Phase::phase_t;
    inst audio: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;

    inst dut: SineWaveLerpCore ( clk, phase, audio );

    var prev     : gndless_fixedpoint::Q4_23::Raw    ;
    var delta    : signed logic                  <32>;
    var max_delta: signed logic                  <32>;

    initial {
        phase     = 0;
        max_delta = 0;
        clk.next(4);

        prev = audio.raw;
        for _ in 0..10000 {
            phase = phase + STEP;
            clk.next(1);

            delta = (audio.raw as 32) - (prev as 32);
            if delta <: 0 {
                delta = -delta;
            }
            if delta >: max_delta {
                max_delta = delta;
            }
            prev = audio.raw;
        }

        $assert(max_delta <: 32'sd1024, "continuous sweep discontinuity");
        $finish();
    }
}
