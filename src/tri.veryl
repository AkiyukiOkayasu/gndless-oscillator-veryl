/// 三角波生成コアモジュール
/// 位相入力から波形を生成する変換モジュール
/// Q4.23をbit sliceで直接生成する (Q1.31経由のconvert相当を不要化)
/// レイテンシー: 3クロック (全wave core統一)
pub module TriangleWaveCore (
    clk  : input   clock                                                                        , /// クロック
    phase: input   gndless_nco::Phase::phase_t                                                  , /// 位相入力 (0 ~ 2^32-1)
    audio: modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    // 三角波シェイピング (Folding)
    var tri_wave: logic<32>;

    // 位相の後半(MSB=1)のときだけビットを反転させることで、「ノコギリ波」を「ピラミッド型 (0 -> Max -> 0)」に変換
    // XORでphase[msb]が 1 の時だけ、下位31bitを反転する
    // 0 -> 2^31-1 -> 0の三角波
    assign tri_wave = {
        1'b0, // MSBはゼロ固定
        phase[msb - 1:0]
            ^ {
                phase[msb] repeat 31
            } // 下位31bitを反転条件付きで反転
    };

    // 出力スケーリングとオフセット
    // bit slice: 31bitフルスケール (2^31-1) を Q4.23 の "+2.0" にスケール
    // ($signed(tri_wave) >>> 7) は上位bitが常に0なので {3'b0, tri_wave[30:7]} と等価
    // オフセット: 0.0～2.0 の範囲を -1.0～1.0 にずらす
    var audio_d1: gndless_fixedpoint::Q4_23::Raw;
    var audio_d2: gndless_fixedpoint::Q4_23::Raw;
    var audio_d3: gndless_fixedpoint::Q4_23::Raw;

    always_ff (clk) {
        audio_d1 = $signed({3'b0, tri_wave[30:7]}) - gndless_fixedpoint::Q4_23::ONE;
        audio_d2 = audio_d1;
        audio_d3 = audio_d2;
    }

    always_comb {
        audio.raw = audio_d3;
    }
}

/// 三角波オシレーター
/// レイテンシー: 3クロック (全wave core統一)
pub module TriangleOscillator (
    clk       : input   clock                                                                        , /// クロック
    phase_rst : input   bbool                                                                        , /// 位相ゼロリセット (同期)
    phase_step: input   gndless_nco::Phase::step_t                                                   , /// 1クロックあたりの位相ステップ量: step = (ターゲット周波数 * 2^48) / システムクロック周波数
    audio     : modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    // 位相生成
    var phase: gndless_nco::Phase::phase_t;
    inst phasor: gndless_nco::Phasor ( clk, phase_rst, phase_step, phase );

    // 三角波生成
    inst core: TriangleWaveCore ( clk, phase, audio );
}

/// 三角波コアの位相変換を検証
#[test(test_triangle_wave_core)]
module test_triangle_wave_core {
    inst clk: $tb::clock_gen;

    var phase: gndless_nco::Phase::phase_t;
    inst audio: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;

    inst dut: TriangleWaveCore ( clk, phase, audio );

    initial {
        phase = 32'h0000_0000;
        clk.next(3);
        $assert(audio.raw == gndless_fixedpoint::Q4_23::NEG_ONE, "三角波の開始点が不正です");

        phase = 32'h4000_0000;
        clk.next(3);
        $assert(audio.raw == gndless_fixedpoint::Q4_23::ZERO, "三角波の頂点が不正です");

        phase = 32'h8000_0000;
        clk.next(3);
        $assert(
            audio.raw >: gndless_fixedpoint::Q4_23::ZERO && audio.raw <: gndless_fixedpoint::Q4_23::ONE,
            "三角波の正の頂点が不正です",
        );

        $finish();
    }
}
