/// ピンクノイズジェネレーター (Voss-McCartney Algorithm + Xorshift32)
///
/// 1/f特性を持つピンクノイズを生成する。
/// 単一のXorshift32 RNGがフリーランし、サンプルカウンタの各ビット立ち上がりでラッチされることで1/fスペクトルを形成する。
///
/// 24段構成:
///   行kは2^kサンプルごとに更新される
///   最低更新レート = sample_rate / 2^24
///   50MHz/200分周(250kHz)前提で約0.015Hz = サブオーディオ帯域まで余裕を持ってカバー
///
/// 出力スケーリング:
///   24行のQ4.23和 (各行はQ1.31解釈の8bit算術右シフト相当) → ÷8(>>>3) = 合計>>>11相当
///   RMS ≈ √(24/3)/8 ≈ 0.35 (WhiteNoise比 -4.2dB)
///
/// レイテンシー: 3クロック (全wave core統一)
pub module PinkNoise #(
    param DIV: u16 = 200, /// クロック分周比
) (
    clk  : input   clock                                                                        , /// クロック
    audio: modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    const INIT_SEED: u32 = 32'h2463_5345;

    var rng_state: logic<32>;

    // クロック分周カウンター
    var cnt: u16;

    // サンプルカウンタと前回値（Voss-McCartneyエッジ検出用）
    var sample_cnt     : logic<24>;
    var prev_sample_cnt: logic<24>;

    // 各行のラッチ値 [24]
    var rows: logic<32> [24];

    always_ff (clk) {
        if cnt == DIV - 1 {
            cnt = 0;

            // Xorshift32 フリーラン
            var next     : logic<32>;
            next      =  if (rng_state == 0) ? INIT_SEED : rng_state;
            next      ^= (next << 13);
            next      ^= (next >> 17);
            next      ^= (next << 5);
            rng_state =  next;

            // サンプルカウンタ更新
            prev_sample_cnt =  sample_cnt;
            sample_cnt      += 1;

            // Voss-McCartney: 各行の更新トリガー検出とラッチ
            // sample_cnt[k] が 0→1 に立ち上がったら行kを更新
            // 行kは 2^k サンプルごとに更新される
            for k in 0..24 {
                if !prev_sample_cnt[k] && sample_cnt[k] {
                    rows[k] = rng_state;
                }
            }
        } else {
            cnt += 1;
        }
    }

    // 全行の加算とスケーリング
    // 各行をQ4.23 (27bit) へ変換して加算し、÷8 (>>>3) で27bitへ縮小する
    // Q1.31解釈の値 {rows[k][31], rows[k][30:0]} の8bit算術右シフトは
    // {rows[k][31] repeat 3, rows[k][31:8]} の bit slice で表せる
    var sum: signed logic<32>;

    always_comb {
        sum = 0;
        for k in 0..24 {
            sum = sum + ($signed({rows[k][msb] repeat 3, rows[k][msb:8]}) as 32);
        }
    }

    var audio_d1: gndless_fixedpoint::Q4_23::Raw;
    var audio_d2: gndless_fixedpoint::Q4_23::Raw;
    var audio_d3: gndless_fixedpoint::Q4_23::Raw;

    always_ff (clk) {
        audio_d1 = (sum >>> 3) as 27;
        audio_d2 = audio_d1;
        audio_d3 = audio_d2;
    }

    always_comb {
        audio.raw = audio_d3;
    }
}
