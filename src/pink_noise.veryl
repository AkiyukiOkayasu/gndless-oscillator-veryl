/// ピンクノイズジェネレーター (Voss-McCartney Algorithm + Xorshift32)
///
/// 1/f特性を持つピンクノイズを生成する。
/// 単一のXorshift32 RNGがフリーランし、サンプルカウンタの各ビット立ち上がりでラッチされることで1/fスペクトルを形成する。
///
/// 24段構成:
///   行kは2^kサンプルごとに更新される
///   最低更新レート = sample_rate / 2^24
///   50MHz/200分周(250kHz)前提で約0.015Hz = サブオーディオ帯域まで余裕を持ってカバー
///
/// 出力スケーリング:
///   24行のQ4.23和 (各行はQ1.31解釈の8bit算術右シフト相当) → ÷8(>>>3) = 合計>>>11相当
///   RMS ≈ √(24/3)/8 ≈ 0.35 (WhiteNoise比 -4.2dB)
///
/// レイテンシー: 3クロック (全wave core統一)
pub module PinkNoise #(
    param DIV: u16 = 200, /// クロック分周比
) (
    clk  : input   clock                                                                        , /// クロック
    audio: modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    const INIT_SEED: u32 = 32'h2463_5345;

    var rng_state: logic<32>;

    // クロック分周カウンター
    var cnt: u16;

    // サンプルカウンタと前回値（Voss-McCartneyエッジ検出用）
    var sample_cnt     : logic<24>;
    var prev_sample_cnt: logic<24>;

    // 各行のラッチ値 [24]
    var rows: logic<32> [24];

    always_ff (clk) {
        if cnt == DIV - 1 {
            cnt = 0;

            // Xorshift32 フリーラン
            var next     : logic<32>;
            next      =  if (rng_state == 0) ? INIT_SEED : rng_state;
            next      ^= (next << 13);
            next      ^= (next >> 17);
            next      ^= (next << 5);
            rng_state =  next;

            // サンプルカウンタ更新
            prev_sample_cnt =  sample_cnt;
            sample_cnt      += 1;

            // Voss-McCartney: 各行の更新トリガー検出とラッチ
            // sample_cnt[k] が 0→1 に立ち上がったら行kを更新
            // 行kは 2^k サンプルごとに更新される
            for k in 0..24 {
                if !prev_sample_cnt[k] && sample_cnt[k] {
                    rows[k] = rng_state;
                }
            }
        } else {
            cnt += 1;
        }
    }

    // 全行の加算とスケーリング
    // 各行をQ1.31として算術右シフト8bit (Q4.23相当) して加算し、÷8 (>>>3) で27bitへ縮小する
    // 注: $signed(concat) の幅拡張castはsim backendで符号拡張されないため、
    //      $signed(rows[k]) >>> 8 の算術シフトで表現する
    var sum: signed logic<32>;

    always_comb {
        sum = 0;
        for k in 0..24 {
            sum = sum + ($signed(rows[k]) >>> 8);
        }
    }

    var audio_d1: gndless_fixedpoint::Q4_23::Raw;
    var audio_d2: gndless_fixedpoint::Q4_23::Raw;
    var audio_d3: gndless_fixedpoint::Q4_23::Raw;

    always_ff (clk) {
        audio_d1 = (sum >>> 3) as 27;
        audio_d2 = audio_d1;
        audio_d3 = audio_d2;
    }

    always_comb {
        audio.raw = audio_d3;
    }
}

/// ピンクノイズの出力レベルを検証
/// 24行のうち初期段階では上位行 (更新レートが遅い行) が未活性のため、
/// 2^14サンプルをスキップした後に2048サンプルを測定する。
/// その時点の活性行は約15行で mean-abs ≈ 0.8 * √(15/3)/8 ≈ 0.22。
/// 許容範囲 [0.15, 0.45] は、過減衰バグ (÷2^16相当、mean-abs ≈ 0.01) を確実に弾く。
#[test(test_pink_noise_level)]
module test_pink_noise_level {
    inst clk  : $tb::clock_gen;
    inst audio: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;

    inst dut: PinkNoise #( DIV: 8 ) ( clk, audio );

    var acc     : u64;
    var mean_abs: u64;

    initial {
        // 2^14サンプル分スキップ (上位行のラッチ待ち) + 出力遅延3クロック
        clk.next((1 << 14) * 8 + 3);
        for _ in 0..2048 {
            if audio.raw <: 0 {
                acc = acc + ((-audio.raw) as u64);
            } else {
                acc = acc + (audio.raw as u64);
            }
            clk.next(8);
        }

        mean_abs = acc / 2048;
        $assert(mean_abs >= 64'd1258291 && mean_abs <= 64'd3774874, "pink noise level out of range");

        $finish();
    }
}
