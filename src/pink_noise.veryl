/// ピンクノイズジェネレーター (Voss-McCartney Algorithm + Xorshift32)
///
/// 1/f特性を持つピンクノイズを生成する。
/// 単一のXorshift32 RNGがフリーランし、サンプルカウンタの各ビット立ち上がりでラッチされることで1/fスペクトルを形成する。
///
/// 24段構成:
///   行kは2^kサンプルごとに更新される
///   最低更新レート = sample_rate / 2^24
///   例: サンプルレート250kHz (50MHz/200分周) で最低更新レート約0.015Hz = サブオーディオ帯域までカバー
///
/// 出力スケーリング:
///   各行をQ1.31として8bit算術右シフトした値 (±1.0) を32bit幅で24行加算する。
///   ÷8 (>>>3) で27bitへ縮小する (Q4.23の±8.0内に収まり、ピーク±3.0)。
///   RMS ≈ √(24/3)/8 ≈ 0.35 (-9 dBFS、WhiteNoise比 -4.2dB)
///
/// レイテンシー: 0クロック (行更新と同時に出力が更新される)
pub module PinkNoise #(
    param DIV: u16 = 200, /// クロック分周比
) (
    clk  : input   clock                                                                        , /// クロック
    audio: modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    const INIT_SEED: u32       = 32'h2463_5345;
    var   rng_state: logic<32>;

    // クロック分周カウンター
    var cnt: u16;

    // サンプルカウンタと前回値（Voss-McCartneyエッジ検出用）
    var sample_cnt     : logic<24>;
    var prev_sample_cnt: logic<24>;

    // 各行のラッチ値 [24]
    var rows: logic<32> [24];

    always_ff (clk) {
        if cnt == DIV - 1 {
            cnt = 0;

            // Xorshift32 フリーラン
            var next     : logic<32>;
            next      =  if (rng_state == 0) ? INIT_SEED : rng_state;
            next      ^= (next << 13);
            next      ^= (next >> 17);
            next      ^= (next << 5);
            rng_state =  next;

            // サンプルカウンタ更新
            prev_sample_cnt =  sample_cnt;
            sample_cnt      += 1;

            // Voss-McCartney: 各行の更新トリガー検出とラッチ
            // sample_cnt[k] が 0→1 に立ち上がったら行kを更新
            // 行kは 2^k サンプルごとに更新される
            for k in 0..24 {
                if !prev_sample_cnt[k] && sample_cnt[k] {
                    rows[k] = rng_state;
                }
            }
        } else {
            cnt += 1;
        }
    }

    // 全行の加算とスケーリング
    // 各行をQ1.31として8bit算術右シフトし (値域±1.0)、24行を加算して ÷8 (>>>3) で27bitへ縮小する
    var sum: signed logic<32>;

    always_comb {
        sum = 0;
        for k in 0..24 {
            sum = sum + ($signed(rows[k]) >>> 8);
        }
        audio.raw = (sum >>> 3) as 27;
    }
}

/// ピンクノイズの出力レベルを検証
/// 24行のうち初期段階では上位行 (更新レートが遅い行) が未活性のため、2^14サンプルをスキップしてから測定する。
/// その時点の活性行は約15行で mean-abs ≈ 0.22。
/// 出力は中心極限定理でほぼガウス分布のため、mean-abs ≈ 0.8 × RMS ≈ 0.8 × √(15/3)/8 となる。
/// 許容範囲 [0.15, 0.45] (設計値の約0.7〜2倍) で、スケーリング異常を検出する。
#[test(test_pink_noise_level)]
module test_pink_noise_level {
    inst clk  : $tb::clock_gen;
    inst audio: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;

    inst dut: PinkNoise #( DIV: 8 ) ( clk, audio );

    var acc     : u64;
    var mean_abs: u64;

    initial {
        // 2^14サンプル分スキップ (上位行のラッチ待ち)。出力は組み合わせなので更新と同時にサンプリングできる。
        clk.next((1 << 14) * 8);
        for _ in 0..2048 {
            if audio.raw <: 0 {
                acc = acc + ((-audio.raw) as u64);
            } else {
                acc = acc + (audio.raw as u64);
            }
            clk.next(8);
        }

        mean_abs = acc / 2048;
        $assert(mean_abs >= 64'd1258291 && mean_abs <= 64'd3774874, "pink noise level out of range");

        $finish();
    }
}
