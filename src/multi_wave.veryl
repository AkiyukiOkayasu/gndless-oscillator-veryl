/// 波形タイプを定義するパッケージ
pub package WaveTypes {
    /// 波形タイプを表す列挙型
    enum WaveType {
        /// サイン波
        Sine,
        /// 三角波
        Triangle,
        /// ノコギリ波
        Saw,
        /// PWM矩形波
        Pwm,
    }
}

/// マルチ波形生成コアモジュール
/// 位相入力から4種類の波形（Sine, Triangle, Saw, Pwm）を生成し、選択出力
/// 各波形は自然なレイテンシーのまま出力される:
///   Sine (線形補間): 3クロック、Triangle/Saw/Pwm: 0クロック (組み合わせ)
/// 波形切替は組み合わせmuxで即時反映される。
/// Sineは他波形より3クロック遅れて出力される (定数遅延)。
/// この差は楽器用途では音色に影響しないため、遅延整列は行わない。
/// 可聴性の分析はREADME「レイテンシー契約」を参照。
pub module MultiWaveCore (
    clk       : input   clock                                                                        , /// クロック
    phase     : input   gndless_nco::Phase::phase_t                                                  , /// 位相入力 (0 ~ 2^32-1)
    wave_type : input   WaveType                                                                     , /// 波形タイプ選択
    duty_cycle: input   gndless_nco::Phase::phase_t                                                  , /// PWMデューティ比 (Pwm以外では無視)
    audio     : modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    import WaveTypes::WaveType;
    import WaveTypes::WaveType::*;

    // 各波形コアの出力
    inst sine_out    : gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;
    inst triangle_out: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;
    inst saw_out     : gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;
    inst square_out  : gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;

    // サイン波コア (線形補間、3クロック)
    inst sine_core: SineWaveLerpCore (
        clk            ,
        phase          ,
        audio: sine_out,
    );

    // 三角波コア (組み合わせ、0クロック)
    inst triangle_core: TriangleWaveCore (
        phase              ,
        audio: triangle_out,
    );

    // ノコギリ波コア (組み合わせ、0クロック)
    inst saw_core: SawWaveCore (
        phase         ,
        audio: saw_out,
    );

    // 矩形波コア (組み合わせ、0クロック)
    inst square_core: SquareWaveCore (
        phase                 ,
        duty_cycle            ,
        audio     : square_out,
    );

    // 波形選択マルチプレクサ (各波形の自然なレイテンシーのまま選択)
    always_comb {
        case wave_type {
            Sine    : audio.raw = sine_out.raw;
            Triangle: audio.raw = triangle_out.raw;
            Saw     : audio.raw = saw_out.raw;
            Pwm     : audio.raw = square_out.raw;
            default : audio.raw = sine_out.raw;
        }
    }
}

/// 波形選択式オシレーター
/// 4種類の波形（Sine, Triangle, Saw, Pwm）を切り替え可能
/// 波形切替は組み合わせmuxで即時反映される (Sineのみ3クロックのレイテンシー)
pub module MultiWaveOscillator (
    clk       : input   clock                                                                        , /// クロック
    phase_rst : input   bbool                                                                        , /// 位相ゼロリセット (同期)
    phase_step: input   gndless_nco::Phase::step_t                                                   , /// 1クロックあたりの位相ステップ量
    wave_type : input   WaveType                                                                     , /// 波形タイプ選択
    duty_cycle: input   gndless_nco::Phase::phase_t                                                  , /// PWMデューティ比 (Pwm以外では無視)
    audio     : modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    import WaveTypes::WaveType;
    import WaveTypes::WaveType::*;

    // 位相生成 (共通Phase::Phasor)
    var phase: gndless_nco::Phase::phase_t;
    inst phasor: gndless_nco::Phasor ( clk, phase_rst, phase_step, phase );

    // マルチ波形生成コア
    inst core: MultiWaveCore ( clk, phase, wave_type, duty_cycle, audio );
}

/// MultiWaveCoreの波形切替とレイテンシーを検証
/// Triangle/Saw/Pwm は組み合わせ (0クロック)、Sine は3クロック (lerp)。
/// 期待値: 45度 (phase=0x2000_0000) で sine=5931640 / triangle=-4194304 / saw=-6291456 / square=ONE (duty=0x4000_0000)
#[test(test_multi_wave_core)]
module test_multi_wave_core {
    import WaveTypes::WaveType;
    import WaveTypes::WaveType::*;

    inst clk: $tb::clock_gen;

    var phase     : gndless_nco::Phase::phase_t;
    var wave_type : WaveType                   ;
    var duty_cycle: gndless_nco::Phase::phase_t;
    inst audio: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;

    inst dut: MultiWaveCore ( clk, phase, wave_type, duty_cycle, audio );

    initial {
        duty_cycle = 32'h4000_0000;
        phase      = 32'h0000_0000;
        wave_type  = WaveType::Triangle;
        $assert(audio.raw == gndless_fixedpoint::Q4_23::NEG_ONE, "triangle 0deg mismatch");

        wave_type = WaveType::Saw;
        $assert(audio.raw == gndless_fixedpoint::Q4_23::NEG_ONE, "saw 0deg mismatch");

        wave_type = WaveType::Pwm;
        $assert(audio.raw == gndless_fixedpoint::Q4_23::ONE, "square 0deg mismatch");

        // Sine は3クロック (lerp)
        phase     = 32'h2000_0000;
        wave_type = WaveType::Sine;
        clk.next(3);
        $assert(audio.raw == 27'sd5931640, "sine 45deg after 3clk mismatch");

        // 組み合わせ波形は即時反映
        wave_type = WaveType::Triangle;
        $assert(audio.raw == -27'sd4194304, "triangle 45deg immediate mismatch");

        wave_type = WaveType::Saw;
        $assert(audio.raw == -27'sd6291456, "saw 45deg immediate mismatch");

        $finish();
    }
}
