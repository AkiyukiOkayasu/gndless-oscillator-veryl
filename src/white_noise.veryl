/// ホワイトノイズジェネレーター (Xorshift32 Algorithm)
///
/// オーディオ用の高品質な疑似乱数ノイズを生成する。
/// リセット信号は不要で、起動後に非ゼロのシードで初期化される。
///
/// 出力スケーリング:
///   rng_state をQ1.31として解釈した値の8bit算術右シフトを直接Q4.23へ変換
///   RMS ≈ 1/√3 ≈ 0.577 (-4.8dBFS)
///
/// レイテンシー: 0クロック (rng_stateの更新と同時に出力が更新される)
pub module WhiteNoise #(
    param DIV: u16 = 200, /// クロック分周比
) (
    clk  : input   clock                                                                        , /// クロック
    audio: modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>::output_port, /// 出力波形 (Q4.23形式)
) {
    // Initial value (Seed) must be non-zero.
    // rng_stateが0の場合、Xorshift32アルゴリズムが停止してしまうため、初期値として非ゼロ値を設定する。
    var   rng_state   : logic<32>;
    const INITIAL_SEED: u32       = 32'h2463_5345;

    // クロック分周カウンター
    // たとえばclkが50MHzの場合、100kHz程度でLPFを通すと振幅が小さくなりすぎる。
    // そのため分周して、エネルギーの分布範囲が広くなりすぎないようにする。
    var cnt: u16;

    always_ff (clk) {
        // クロック分周
        if (cnt == DIV - 1) {
            cnt = 0;

            // Xorshift32 algorithm:
            // x ^= x << 13;
            // x ^= x >> 17;
            // x ^= x << 5;
            var next: logic<32>;
            next =  if (rng_state == 0) ? INITIAL_SEED : rng_state;
            next ^= (next << 13);
            next ^= (next >> 17);
            next ^= (next << 5);

            rng_state = next;
        } else {
            cnt += 1;
        }
    }

    // Q4.23直接生成: rng_stateをQ1.31 (符号=rng[31]) と解釈し、8bit右シフトでQ4.23へスケーリングする
    // binary pointは出力bit22。データ部 rng[30:8] が出力の [22:0] にそのまま乗る
    // 8bit右シフトは配線のみ: {符号rng[31]を4回複製, データ23bit} = 27bit (値域 ±2^23 = ±1.0)
    // xorshift32は下位ビットのランダム性が劣るため上位23bitを使用する
    always_comb {
        audio.raw = $signed({rng_state[msb] repeat 4, rng_state[msb - 1:8]});
    }
}

/// ホワイトノイズの出力レベルを検証
/// 一様分布 [-1, 1) のmean-abs ≈ 0.5 なので、Q4.23で ≈ 0.5 * 2^23 = 4194304。
/// 許容範囲 [0.45, 0.55] * 2^23 で、2048サンプルの統計誤差 (3σ≈1%) を吸収する。
#[test(test_white_noise_level)]
module test_white_noise_level {
    inst clk  : $tb::clock_gen;
    inst audio: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23>;

    inst dut: WhiteNoise #( DIV: 8 ) ( clk, audio );

    var acc     : u64;
    var mean_abs: u64;

    initial {
        // rng_state初期値は0のため、初回更新 (8クロック後) でINITIAL_SEEDに初期化される。
        // 出力は組み合わせなので更新と同時にサンプリングできる。
        clk.next(8);
        for _ in 0..2048 {
            if audio.raw <: 0 {
                acc = acc + ((-audio.raw) as u64);
            } else {
                acc = acc + (audio.raw as u64);
            }
            clk.next(8);
        }

        mean_abs = acc / 2048;
        $assert(mean_abs >= 64'd3774874 && mean_abs <= 64'd4613735, "white noise level out of range");

        $finish();
    }
}
